# ==============================================================================
# Sophos Security Mobile - Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets or production credentials to version control.
# Copy this file to .env and configure for your deployment environment.

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-jwt-signing
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite is supported out-of-the-box for development and testing.
# For production, use PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/sophos_mobile
DATABASE_URL=sqlite+aiosqlite:///./sophos_mobile.db

# ------------------------------------------------------------------------------
# Sophos Central API Credentials
# Reference: https://developer.sophos.com/apis/
# ------------------------------------------------------------------------------
# Set to 'true' to use the realistic offline mock adapter when Sophos credentials are not yet configured.
SOPHOS_MOCK_MODE=true

# Sophos Central Service Principal (Client Credentials)
SOPHOS_CLIENT_ID=your-sophos-client-id-here
SOPHOS_CLIENT_SECRET=your-sophos-client-secret-here

# Optional: Pre-configured Tenant ID (if omitted, will be discovered via /whoami)
SOPHOS_TENANT_ID=your-sophos-tenant-id-here
# Regional API Base URL (discovered automatically via whoami, e.g., https://api-us01.central.sophos.com)
SOPHOS_DATA_REGION_URL=

# ------------------------------------------------------------------------------
# Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
FCM_ENABLED=false
FCM_PROJECT_ID=your-fcm-project-id
FCM_SERVICE_ACCOUNT_KEY_PATH=

# ------------------------------------------------------------------------------
# Security & Operational Safeguards
# ------------------------------------------------------------------------------
# Rate limiting (requests per minute per IP / token)
RATE_LIMIT_PER_MINUTE=120
# Step-up authorization requirement for destructive response actions (e.g., endpoint isolation)
REQUIRE_STEP_UP_AUTH_FOR_ACTIONS=true
# Emergency freeze for all write/response actions (kill-switch)
EMERGENCY_RESPONSE_ACTIONS_FROZEN=false
